            "value": "滤波后 %@"
          }
        }
      }
    },
    "학습 안 됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not trained"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未学習"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未训练"
          }
        }
      }
    },
    "학습 오차": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習誤差"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练误差"
          }
        }
      }
    },
    "학습에 실패했습니다. 고개와 눈을 조금 더 움직여 점을 바라보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training failed. Move your head and eyes a bit more as you look at the dots."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習に失敗しました。顔と目をもう少し動かして点を見てください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练失败。注视圆点时请稍微多移动头部和眼睛。"
          }
        }
      }
    },
    "학습한 보정": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trained calibration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習したキャリブレーション"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已训练的校准"
          }
        }
      }
    },
    "항목": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Series"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目"
          }
        }
      }
    },
    "허용됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "화면 상단에 알림 위치 표시": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show notification position at top of screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上部に通知の位置を表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕顶部显示通知位置"
          }
        }
      }
    },
    "화면 여기저기를 바라보며 막대가 시선을 따라오는지 확인하세요. 이 탭을 보는 동안은 %lld회/s 로 추적합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look around the screen and check that the bar follows your gaze. While this tab is visible, tracking runs at %lld/s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のあちこちを見て、バーが視線についてくるか確認してください。このタブの表示中は%lld回/秒で追跡します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环顾屏幕，确认位置条跟随你的视线。显示此标签时以 %lld 次/秒跟踪。"
          }
        }
      }
    },
    "화면 위쪽에 점 %lld개가 왼쪽부터 차례로 나타납니다.\n평소 작업할 때처럼 자연스럽게 바라보세요. 고개를 돌려도 괜찮습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dots will appear one by one across the top of the screen, starting from the left.\nLook at them naturally, as you would while working. It's fine to turn your head."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上部に%lld個の点が左から順に表示されます。\n普段作業するときのように自然に見てください。顔を向けても構いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上方会从左到右依次出现 %lld 个圆点。\n请像平时工作一样自然地注视。转头也没关系。"
          }
        }
      }
    },
    "화면 폭의 %@%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%% of screen width"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面幅の%@%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕宽度的 %@%%"
          }
        }
      }
    },
    "화면이 꺼져 있거나 잠겨 있어 카메라를 끔": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera off because the display is off or locked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面がオフまたはロック中のためカメラをオフ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因屏幕关闭或锁定已关闭摄像头"
          }
        }
      }
    },
    "화면이 꺼졌거나 오래 자리를 비움": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display off, or away for a long time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面がオフ、または長く離席中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕关闭或长时间离开"
          }
        }
      }
    },
    "회/s": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "/s"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回/秒"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "次/秒"
          }
        }
      }
    },
    "횟수/s": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate/s"
          }
        },
        "ja": {
          "stringUnit": {

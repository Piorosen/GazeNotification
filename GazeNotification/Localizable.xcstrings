    "카메라": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头"
          }
        }
      }
    },
    "카메라 미리보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Preview"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラプレビュー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头预览"
          }
        }
      }
    },
    "카메라 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラなし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无摄像头"
          }
        }
      }
    },
    "카메라 프레임": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera frames"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラフレーム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头帧"
          }
        }
      }
    },
    "카메라 프레임 속도는 이 값 이상 중 카메라가 지원하는 가장 낮은 값으로 자동 설정됩니다%@. 보정, 카메라 미리보기, 보정 조정 중에는 초당 %lld회로 고정됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera frame rate is set automatically to the lowest rate the camera supports at or above these values%1$@. It's fixed at %2$lld/s during calibration, camera preview, and calibration tuning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラのフレームレートは、この値以上でカメラが対応する最も低い値に自動設定されます%1$@。キャリブレーション、カメラプレビュー、キャリブレーション調整中は毎秒%2$lld回に固定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "카메라 프레임 속도는 이 값 이상 중 카메라가 지원하는 가장 낮은 값으로 자동 설정됩니다%1$@. 보정, 카메라 미리보기, 보정 조정 중에는 초당 %2$lld회로 고정됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头帧率会自动设为不低于该值的摄像头所支持的最低值%1$@。在校准、摄像头预览和校准调整期间固定为每秒 %2$lld 次。"
          }
        }
      }
    },
    "카메라 화면에서 얼굴의 가로 위치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal face position in the camera image"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ画像内での顔の横位置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面部在摄像头画面中的水平位置"
          }
        }
      }
    },
    "카메라를 연결할 수 없습니다: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect to the camera: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラに接続できません：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接摄像头：%@"
          }
        }
      }
    },
    "코 방향": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nose direction"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鼻の向き"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼻子方向"
          }
        }
      }
    },
    "코 방향, 동공 위치, 얼굴 위치 계산": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate nose direction, pupil position, and face position"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鼻の向き、瞳孔の位置、顔の位置を計算"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算鼻子方向、瞳孔位置和面部位置"
          }
        }
      }
    },
    "코 방향, 동공 위치, 얼굴 위치, 머리 회전을 사용합니다. 눈의 움직임까지 반영하여 가장 정확합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses nose direction, pupil position, face position, and head rotation. Also reflects eye movement, so it's the most accurate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鼻の向き、瞳孔の位置、顔の位置、頭の回転を使用します。目の動きまで反映するため、最も正確です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用鼻子方向、瞳孔位置、面部位置和头部转动。还会反映眼睛的移动，因此最准确。"
          }
        }
      }
    },
    "테스트 모드에서는 테스트 알림을 보내지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test notifications aren't sent in test mode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストモードではテスト通知を送信しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试模式下不发送测试通知。"
          }
        }
      }
    },
    "테스트 알림": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test Notification"
          }
        },

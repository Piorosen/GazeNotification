          }
        }
      }
    },
    "알림 권한이 없습니다 — 시스템 설정 → 알림 → GazeNotification 허용": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notification permission — allow it in System Settings → Notifications → GazeNotification"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の権限がありません — システム設定 → 通知 → GazeNotification で許可してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有通知权限 — 请在 系统设置 → 通知 → GazeNotification 中允许"
          }
        }
      }
    },
    "알림 막 뜸 — 빠르게 확인 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification just appeared — checking quickly"
          }
        },
        "ja": {
          "stringUnit": {

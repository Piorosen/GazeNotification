          "stringUnit": {
            "state": "translated",
            "value": "摄像头·AI CPU 超过上限，处理次数已降至 %@%%"
          }
        }
      }
    },
    "카메라·AI CPU 가 상한을 넘어 처리 횟수를 %@%% 로 줄이는 중 — 상한이 카메라 수신 비용보다 낮아 최소 속도로 동작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera & AI CPU is over the limit; processing rate reduced to %@%% — the limit is below the camera's capture cost, so it runs at the minimum rate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ・AIのCPUが上限を超えたため、処理回数を%@%%に削減中 — 上限がカメラ受信のコストより低いため最低速度で動作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头·AI CPU 超过上限，处理次数已降至 %@%% — 上限低于摄像头接收开销，以最低速度运行"
          }
        }
      }
    },
    "카메라·AI CPU 상한": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera & AI CPU limit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ・AIのCPU上限"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头·AI CPU 上限"
          }
        }
      }
    },
    "카메라·AI 상한 %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera & AI limit %lld%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ・AI上限 %lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头·AI 上限 %lld%%"
          }
        }
      }
    },
    "코 방향": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nose direction"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鼻の向き"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼻子方向"
          }
        }
      }
    },
    "코 방향 · 동공 위치 · 얼굴 위치 · 머리 yaw 를 모두 씁니다. 눈동자 움직임까지 반영해 가장 정확합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses nose direction, pupil position, face position, and head yaw. Also reflects eye movement, so it is the most accurate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鼻の向き・瞳孔の位置・顔の位置・頭のyawをすべて使います。目の動きまで反映するため最も正確です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用鼻子方向·瞳孔位置·人脸位置·头部 yaw。还会反映眼球运动，因此最准确。"
          }
        }
      }
    },
    "코어 1개 = 100%. 카메라·AI = 메인 스레드를 뺀 나머지(카메라 수신·Vision·Neural Engine 드라이버)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 core = 100%. Camera & AI = everything except the main thread (camera capture, Vision, Neural Engine driver)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1コア = 100%。カメラ・AI = メインスレッドを除く残り（カメラ受信・Vision・Neural Engineドライバ）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个核心 = 100%。摄像头·AI = 除主线程外的其余部分（摄像头接收·Vision·Neural Engine 驱动）"
          }
        }
      }
    },
    "큰 시선 이동에 반응": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response to large gaze moves"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな視線移動への反応"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对大幅视线移动的响应"
          }
        }
      }
    },
    "테스트 알림": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test Notification"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト通知"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试通知"
          }
        }
      }
    },
    "테스트 알림 — 테스트 모드에서는 보내지 않음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test notification — not sent in test mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト通知 — テストモードでは送信しない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试通知 — 测试模式下不发送"
          }
        }
      }
    },
    "테스트 알림 전송": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test notification sent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト通知を送信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送测试通知"
          }
        }
      }
    },
    "특징": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feature"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特徴"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特征"
          }
        }
      }
    },
    "특징 %lld개 → 화면 가로 위치 x": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld features → horizontal screen position x"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特徴%lld個 → 画面の横位置x"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个特征 → 屏幕水平位置 x"
          }
        }
      }
    },
    "특징 가중치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feature weights"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特徴の重み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特征权重"
          }
        }
      }
    },
    "특징 이름에 마우스를 올리면 측정 방법이 보입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover over a feature name to see how it is measured."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特徴名にマウスを重ねると計測方法が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将鼠标悬停在特征名称上可查看测量方法。"
          }
        }
      }
    },
    "특징의 세제곱 항을 더해 화면 양 끝으로 갈수록 휘는 관계(고개를 돌린 각도 ↔ 위치)까지 맞춥니다. 보정 점이 적으면 과적합될 수 있음.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds cubed feature terms to fit the relationship that bends toward the screen edges (head angle ↔ position). May overfit with few calibration points."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特徴の3乗項を加え、画面の両端に向かうほど曲がる関係（顔を向けた角度 ↔ 位置）まで合わせます。キャリブレーション点が少ないと過学習することがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入特征的三次项，以拟合越靠近屏幕两端越弯曲的关系（转头角度 ↔ 位置）。校准点较少时可能过拟合。"
          }
        }
      }
    },
    "평소 사용에 맞춘 기본값": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults for everyday use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段使い向けの標準値"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合日常使用的默认值"
          }
        }
      }
    },
    "프레임당 %@ 중 CPU %@ — 나머지는 Neural Engine 결과 대기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of %1$@ per frame, CPU %2$@ — the rest is waiting for the Neural Engine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1フレームあたり %1$@ のうち CPU %2$@ — 残りはNeural Engineの結果待ち"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "프레임당 %1$@ 중 CPU %2$@ — 나머지는 Neural Engine 결과 대기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每帧 %1$@ 中 CPU %2$@ — 其余为等待 Neural Engine 结果"
          }
        }
      }
    },
    "프로필": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置"
          }
        }
      }
    },
    "프로필 값으로 되돌리기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to profile values"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルの値に戻す"
          }
        },
        "zh-Hans": {
          "stringUnit": {

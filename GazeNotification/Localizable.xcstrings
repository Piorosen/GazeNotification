            "state": "translated",
            "value": "正在显示通知"
          }
        }
      }
    },
    "알림을 보고 있는 곳으로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications where you look"

    },
    "현재 할당: 얼굴 검출 %@, 랜드마크(76개) %@, 랜드마크(65개) %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigned: face detection %1$@, landmarks (76) %2$@, landmarks (65) %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の割り当て：顔検出 %1$@、ランドマーク（76点）%2$@、ランドマーク（65点）%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "현재 할당: 얼굴 검출 %1$@, 랜드마크(76개) %2$@, 랜드마크(65개) %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前分配：人脸检测 %1$@，特征点（76 个）%2$@，特征点（65 个）%3$@"
          }
        }
      }
    },
    "현재: %@": {

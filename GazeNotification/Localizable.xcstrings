    "%@ (학습 오차 %@, 교차 검증 오차 %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (training error %2$@, cross-validation error %3$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（学習誤差 %2$@、交差検証誤差 %3$@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (학습 오차 %2$@, 교차 검증 오차 %3$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（训练误差 %2$@，交叉验证误差 %3$@）"
          }
        }
      }
    },
    "%@ 모델은 %@ 방식으로 학습되지 않아 %@ 모델을 사용합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn't trained for %2$@ mode, so %3$@ is used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@方式で学習されていないため、%3$@を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ 모델은 %2$@ 방식으로 학습되지 않아 %3$@ 모델을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未针对%2$@方式训练，因此使用%3$@。"
          }
        }
      }
    },
    "%@ 방식 1회 처리 CPU: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU per run in %1$@ mode: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@方式の1回あたりのCPU：%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ 방식 1회 처리 CPU: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@方式单次处理 CPU：%2$@"
          }
        }
      }
    },
    "%@ 방식, %@\n학습 오차 %@, 교차 검증 오차 %@, 샘플 %lld개\n보정 일시: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mode, %2$@\nTraining error %3$@, cross-validation error %4$@, %5$lld samples\nCalibrated: %6$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@方式、%2$@\n学習誤差 %3$@、交差検証誤差 %4$@、サンプル %5$lld件\nキャリブレーション日時：%6$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ 방식, %2$@\n학습 오차 %3$@, 교차 검증 오차 %4$@, 샘플 %5$lld개\n보정 일시: %6$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@方式，%2$@\n训练误差 %3$@，交叉验证误差 %4$@，样本 %5$lld 个\n校准时间：%6$@"
          }
        }
      }
    },

          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开销"
          }
        }
      }
    },
    "빠르게 따라가지만 전력을 가장 많이 씀": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows quickly but uses the most power"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素早く追従するが電力を最も多く使う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随最快，但最耗电"
          }
        }
      }
    },
    "빠른 위치 맞춤": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Position Fit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック位置合わせ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速位置校正"
          }
        }
      }
    },
    "빠른 위치 맞춤 (3점, 약 10초)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Position Fit (3 points, about 10 s)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック位置合わせ（3点、約10秒）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速位置校正（3 点，约 10 秒）"
          }
        }
      }
    },
    "빠른 위치 맞춤은 학습한 보정은 그대로 두고 왼쪽 끝·가운데·오른쪽 끝을 볼 때의 값으로 아래 \"위치\"만 다시 계산합니다. 전체 보정을 새로 하면 위치 조정은 초기화됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Position Fit keeps the trained calibration and recalculates only \"Position\" below from looking at the left edge, center, and right edge. A new full calibration resets the position adjustments."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック位置合わせは学習したキャリブレーションはそのままに、左端・中央・右端を見たときの値から下の「位置」だけを再計算します。全体のキャリブレーションをやり直すと位置の調整はリセットされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速位置校正会保留已训练的校准，只根据看向左端·中间·右端时的值重新计算下方的“位置”。重新进行完整校准会重置位置调整。"
          }
        }
      }
    },
    "사용 안 함 (머리 방향 방식)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not used (head pose method)"

            "value": "顔検出の間隔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸检测间隔"
          }
        }
      }
    },
    "얼굴 검출로 추정한 머리의 좌우 회전 각도": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left–right head angle estimated by face detection"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔検出で推定した頭の左右の回転角度"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过人脸检测估算的头部左右转动角度"
          }
        }
      }
    },
    "얼굴 검출을 건너뛴 프레임은 이전 얼굴 위치를 기준으로 추적합니다. 영상 처리 CPU가 한도를 넘으면 처리 횟수를 자동으로 줄입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames that skip face detection are tracked from the previous face position. If video processing CPU exceeds the limit, the processing rate is reduced automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔検出を省略したフレームは、前回の顔の位置をもとに追跡します。映像処理のCPUが上限を超えると、処理回数を自動的に減らします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过人脸检测的帧会根据上一次的面部位置进行跟踪。视频处理 CPU 超过上限时，会自动降低处理次数。"
          }
        }
      }
    },
    "얼굴 분석 방식": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face analysis method"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔の解析方式"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸分析方式"
          }
        }
      }
    },
    "얼굴 위치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face position"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔の位置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸位置"
          }
        }
      }
    },
    "얼굴과 머리 방향 검출": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect face and head direction"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔と頭の向きを検出"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测面部和头部朝向"
          }
        }
      }
    },
    "얼굴을 충분히 인식하지 못했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough face data was captured."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔を十分に検出できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能充分检测到面部。"
          }
        }
      }
    },
    "얼굴을 충분히 인식하지 못했습니다. 카메라 위치와 조명을 확인한 후 다시 시도하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough face data was captured. Check the camera position and lighting, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔を十分に検出できませんでした。カメラの位置と照明を確認してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能充分检测到面部。请检查摄像头位置和光线后重试。"
          }
        }
      }
    },
    "얼굴이 감지되지 않아 마지막 위치를 유지합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No face detected. Keeping the last position."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔が検出されないため、最後の位置を維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到面部，保持上一个位置。"
          }
        }
      }
    },
    "얼굴이 감지되지 않음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No face detected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔が検出されません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到面部"
          }
        }
      }
    },
    "연산 장치": {
      "localizations": {
        "en": {
          "stringUnit": {

            "state": "translated",
            "value": "x = 0.5 + Σ 斜率 ×（值 − 基准）"
          }
        }
      }
    },
    "x = 평균 + Σ 기울기 × (값 − 보정 때 평균)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "x = mean + Σ slope × (value − calibration mean)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "x = 平均 + Σ 傾き ×（値 − キャリブレーション時の平均）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "x = 均值 + Σ 斜率 ×（值 − 校准时的均值）"
          }
        }
      }
    },
    "x = 평균 + Σ 기울기 × (값 − 보정 때 평균) + 거듭제곱 항": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "x = mean + Σ slope × (value − calibration mean) + power terms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "x = 平均 + Σ 傾き ×（値 − キャリブレーション時の平均）+ べき乗項"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "x = 均值 + Σ 斜率 ×（值 − 校准时的均值）+ 幂次项"
          }
        }
      }
    },
    "x = 평균 + Σ 기울기 × 특징. 가장 단순하고 안정적.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "x = mean + Σ slope × feature. The simplest and most stable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "x = 平均 + Σ 傾き × 特徴。最も単純で安定。"

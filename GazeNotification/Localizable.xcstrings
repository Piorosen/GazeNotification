          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接通电源"
          }
        }
      }
    },
    "전원에 연결되어 있으면 균형, 배터리 사용 중이거나 저전력 모드 또는 발열이 높을 때는 절전을 사용합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Balanced when connected to power, and Power Saving on battery, in Low Power Mode, or at high temperature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に接続中はバランス、バッテリー使用中、低電力モード、または発熱が多いときは省電力を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接通电源时使用“均衡”，使用电池、处于低电量模式或温度较高时使用“节能”。"
          }
        }
      }
    },

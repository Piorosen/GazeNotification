    "대기 — 알림 없음, 창을 시선 위치에 미리 배치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle — no notification, window pre-positioned at gaze"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機 — 通知なし、ウインドウを視線の位置に事前配置"
          }
        },
        "zh-Hans": {

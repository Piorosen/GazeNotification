        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力モード オン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低电量模式 开"
          }
        }
      }
    },
    "전력 효율이 가장 좋습니다. 없으면 GPU → CPU 순.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most power-efficient. Falls back to GPU, then CPU."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電力効率が最も良いです。なければ GPU → CPU の順。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能效最佳。没有时依次使用 GPU → CPU。"
          }
        }
      }
    },
    "전원 연결": {
      "localizations": {
        "en": {
          "stringUnit": {

          }
        }
      }
    },
    "영상 처리 CPU": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video processing CPU"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像処理のCPU"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频处理 CPU"
          }
        }
      }
    },
    "영상 처리 CPU 한도": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video processing CPU limit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像処理のCPU上限"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频处理 CPU 上限"
          }
        }
      }
    },
    "영상 처리 CPU가 한도를 초과하여 처리 횟수를 %@%%로 줄였습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video processing CPU exceeded the limit, so the processing rate was reduced to %@%%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像処理のCPUが上限を超えたため、処理回数を%@%%に減らしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频处理 CPU 超过上限，处理次数已降至 %@%%。"
          }
        }
      }
    },
    "영상 처리 CPU가 한도를 초과하여 최소 처리 횟수로 동작합니다. 한도가 카메라 수신에 필요한 CPU보다 낮습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video processing CPU exceeded the limit, so processing runs at the minimum rate. The limit is lower than the CPU needed for camera capture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像処理のCPUが上限を超えたため、最小の処理回数で動作しています。上限がカメラの受信に必要なCPUより低く設定されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频处理 CPU 超过上限，正以最低处理次数运行。上限低于摄像头接收所需的 CPU。"
          }
        }
      }
    },
    "영상 처리 한도 %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video processing limit %lld%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像処理の上限 %lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频处理上限 %lld%%"
          }
        }
      }
    },
    "예상 처리량": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理量の見積もり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计处理量"
          }
        }
      }
    },
    "오류: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误：%@"
          }
        }
      }
    },
    "오른쪽 값은 이 Mac에서 측정한 1회 처리당 CPU 시간과, 마지막 보정에서 가장 정확했던 모델의 오차입니다. CPU 시간은 해당 방식을 사용한 후에 표시됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right: CPU time per run measured on this Mac, and the error of the most accurate model from the last calibration. CPU time appears after the method has been used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右の値は、このMacで計測した1回あたりのCPU時間と、前回のキャリブレーションで最も正確だったモデルの誤差です。CPU時間はその方式を使用した後に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧数值为在这台 Mac 上测得的单次处理 CPU 时间，以及上次校准中最准确模型的误差。CPU 时间会在使用该方式后显示。"
          }
        }
      }
    },
    "오른쪽 범위": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right range"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右の範囲"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧范围"
          }
        }
      }
    },
    "오차 %@ (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error %1$@ (%2$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誤差 %1$@（%2$@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "오차 %1$@ (%2$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "误差 %1$@（%2$@）"
          }
        }
      }
    },
    "오차는 화면 폭에 대한 비율입니다. 자동을 선택하면 교차 검증 오차가 가장 작은 모델을 사용합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error is a percentage of the screen width. Automatic uses the model with the lowest cross-validation error."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誤差は画面幅に対する割合です。自動を選択すると、交差検証誤差が最も小さいモデルを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "误差为相对于屏幕宽度的比例。选择“自动”时，会使用交叉验证误差最小的模型。"
          }
        }
      }
    },
    "완료 (오차 %@, %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done (error %1$@, %2$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了（誤差 %1$@、%2$@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "완료 (오차 %1$@, %2$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成（误差 %1$@，%2$@）"
          }
        }
      }
    },
    "왼쪽 끝, 가운데, 오른쪽 끝에 표시되는 점을 차례로 바라보세요.\n기존 보정은 유지하고 위치와 범위만 다시 맞춥니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the dots at the left edge, center, and right edge in turn.\nYour calibration is kept; only position and range are adjusted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左端、中央、右端に表示される点を順に見てください。\n既存のキャリブレーションはそのままで、位置と範囲だけを調整します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请依次注视左端、中间和右端显示的点。\n保留现有校准，仅重新调整位置和范围。"
          }
        }
      }
    },
    "왼쪽 범위": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left range"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の範囲"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左侧范围"
          }
        }
      }
    },
    "왼쪽, 가운데, 오른쪽을 볼 때의 추정값 차이가 너무 작습니다. 먼저 시선 보정을 실행하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimates for left, center, and right are too close together. Run gaze calibration first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左、中央、右を見たときの推定値の差が小さすぎます。先に視線キャリブレーションを実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注视左侧、中间和右侧时的估计值差异太小。请先进行视线校准。"
          }
        }
      }
    },
    "움직임": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動き"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运动"
          }
        }
      }
    },
    "위치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置"
          }
        }
      }
    },
    "위치 기준": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position source"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置の基準"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置依据"
          }
        }
      }
    },
    "위치 기준이 마우스로 설정되어 있어 카메라와 시선 추적이 꺼져 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The position source is set to Mouse, so the camera and gaze tracking are off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置の基準がマウスに設定されているため、カメラと視線追跡はオフです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置依据设为鼠标，因此摄像头和视线跟踪已关闭。"
          }
        }
      }
    },
    "위치 초기화": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Position"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置をリセット"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置位置"
          }
        }
      }
    },
    "일반적인 사용에 권장하는 설정입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended for everyday use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の使用におすすめの設定です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合日常使用的推荐设置。"
          }

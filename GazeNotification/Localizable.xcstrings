          }
        }
      }
    },
    "알림 센터 패널 열림 — 원위치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification Center panel open — restored"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知センターのパネルが開いている — 元の位置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知中心面板已打开 — 已复位"
          }
        }
      }
    },
    "알림 창 AX 구조 저장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Notification Window AX Structure"
          }
        },

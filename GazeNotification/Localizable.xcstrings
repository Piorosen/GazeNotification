    "추적: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟踪：%@"
          }
        }
      }
    },
    "추정 위치가 한쪽으로 치우치면 좌우 이동을 조정하세요. 화면 끝까지 닿지 않으면 해당 방향의 범위를 늘리세요. 범위는 화면 가운데를 기준으로 조정됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the estimate leans to one side, adjust Shift. If it doesn't reach an edge of the screen, increase the range on that side. Ranges are adjusted from the center of the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定位置が片側に偏る場合は、左右の移動を調整してください。画面の端まで届かない場合は、その方向の範囲を広げてください。範囲は画面の中央を基準に調整されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果估计位置偏向一侧，请调整左右偏移。如果无法到达屏幕边缘，请扩大该方向的范围。范围以屏幕中央为基准进行调整。"
          }
        }
      }
    },
    "추정 위치가 허용 범위를 벗어났습니다. 먼저 시선 보정을 실행하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimated position is out of range. Run gaze calibration first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定位置が許容範囲を外れています。先に視線キャリブレーションを実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估计位置超出允许范围。请先进行视线校准。"
          }
        }
      }
    },
    "취소됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消"
          }
        }
      }
    },
    "취소하려면 esc 키를 누르세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Esc to cancel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルするにはescキーを押してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 esc 键取消。"
          }
        }
      }
    },

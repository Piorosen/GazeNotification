    "절전": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power Saving"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "省電力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节能"
          }
        }
      }
    },
    "점 3개(왼쪽 끝 · 가운데 · 오른쪽 끝)를 차례로 바라보세요.\n학습한 보정은 그대로 두고 좌우 이동과 범위만 다시 맞춥니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the 3 dots in turn (left edge · center · right edge).\nThe trained calibration is kept; only the shift and ranges are refitted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つの点（左端・中央・右端）を順に見てください。\n学習したキャリブレーションはそのままに、左右の移動と範囲だけを合わせ直します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请依次注视 3 个点（左端 · 中间 · 右端）。\n保留已训练的校准，只重新调整左右偏移和范围。"
          }
        }
      }
    },
    "점 좌표 → 코 방향·동공 위치·얼굴 위치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point coordinates → nose direction, pupil position, face position"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点の座標 → 鼻の向き・瞳孔の位置・顔の位置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点坐标 → 鼻子方向·瞳孔位置·人脸位置"
          }
        }
      }
    },

    "보정 초기화": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Calibration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャリブレーションをリセット"
          }
        },
        "zh-Hans": {
          "stringUnit": {

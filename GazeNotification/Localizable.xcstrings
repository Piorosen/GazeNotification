    "학습 안 됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not trained"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未学習"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未训练"
          }
        }
      }
    },
    "학습 오차": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習誤差"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练误差"
          }
        }
      }
    },
    "한 번 보정하면 모든 분석 방식과 모델이 함께 학습되므로, 다시 보정하지 않고 바꿔 가며 비교할 수 있습니다. 교차 검증 오차는 보정 점을 하나씩 제외하고 예측한 오차로, 실제 사용 시 정확도에 더 가깝습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One calibration trains every analysis method and model, so you can switch between them and compare without recalibrating. Cross-validation error comes from predicting each calibration point with that point left out, so it is closer to real-world accuracy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回のキャリブレーションですべての解析方式とモデルを学習するため、再キャリブレーションせずに切り替えて比較できます。交差検証誤差は、キャリブレーション点を1つずつ除外して予測した誤差で、実際の使用時の精度により近い値です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次校准会同时训练所有分析方式和模型，因此无需重新校准即可切换比较。交叉验证误差是逐个排除校准点后预测得到的误差，更接近实际使用时的精度。"
          }
        }
      }
    },
    "항목": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Series"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目"
          }
        }
      }
    },
    "허용 안 됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not allowed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未允许"
          }
        }
      }
    },
    "허용됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "현재 AI 모드(%@ 방식, %@)로 학습된 보정이 없어 기본 추정식을 사용합니다. 다시 보정하면 모든 방식과 모델이 학습됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no calibration trained for the current AI mode (%1$@ mode, %2$@), so the default formula is used. Recalibrating trains every method and model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のAIモード（%1$@方式、%2$@）で学習したキャリブレーションがないため、標準推定式を使用します。再キャリブレーションするとすべての方式とモデルを学習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "현재 AI 모드(%1$@ 방식, %2$@)로 학습된 보정이 없어 기본 추정식을 사용합니다. 다시 보정하면 모든 방식과 모델이 학습됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 AI 模式（%1$@方式，%2$@）没有已训练的校准，因此使用默认估算公式。重新校准会训练所有方式和模型。"
          }
        }
      }
    },
    "현재 상태": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の状態"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前状态"
          }
        }
      }
    },
    "현재 프로필: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current profile: %@"
          }
        },

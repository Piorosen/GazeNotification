    "느리게 움직이면 강하게, 빠르면 약하게 평활": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooths strongly when moving slowly, lightly when fast"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくりなら強く、速ければ弱く平滑化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动慢时强平滑，移动快时弱平滑"
          }
        }
      }
    },
    "다시 시작하면 바뀝니다": {

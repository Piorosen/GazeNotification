            "value": "通知が表示された直後 — すばやく確認中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知刚出现 — 正在快速检查"
          }
        }
      }
    },
    "알림 배치 (Accessibility)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification placement (Accessibility)"
          }
        },
        "ja": {

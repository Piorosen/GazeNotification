            "state": "translated",
            "value": "预览"
          }
        }
      }
    },
    "반응 속도": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response speed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反応速度"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应速度"
          }
        }
      }
    },
    "반응 속도를 낮추면 위치가 안정되지만 시선을 늦게 따라갑니다. 화면 구역을 설정하면 화면을 같은 폭으로 나누고 각 구역의 가운데에 알림을 표시합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lower response speed steadies the position but follows your gaze more slowly. With screen zones, the screen is divided into equal zones and notifications appear in the center of each zone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反応速度を下げると位置は安定しますが、視線への追従が遅くなります。画面の区画を設定すると、画面を同じ幅に分割し、各区画の中央に通知を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降低响应速度可使位置更稳定，但跟随视线会变慢。设置屏幕区域后，屏幕会被等宽划分，通知显示在各区域的中间。"
          }
        }
      }
    },
    "반응이 가장 빠르지만 전력 소비가 가장 많습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastest response, but uses the most power."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反応が最も速いですが、消費電力が最も多くなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应最快，但耗电量最大。"
          }
        }
      }
    },
    "발열 %@": {

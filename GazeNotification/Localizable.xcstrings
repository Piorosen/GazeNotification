          }
        }
      }
    },
    "떠 있는 알림이 따라오는 최소 이동": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum move for shown notification to follow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の通知が追従する最小移動量"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已显示通知跟随的最小移动"
          }
        }
      }
    },
    "떨림 억제 (기본 반응 속도)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jitter suppression (base response)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "揺れの抑制（基本の反応速度）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抖动抑制（基础响应速度）"
          }
        }
      }
    },
    "떨림 억제를 낮추면 위치가 안정되지만 늦게 따라옵니다. 구역 나누기를 켜면 화면을 N칸으로 나눠 알림을 칸 가운데에 띄웁니다 (경계 근처에서 왔다 갔다 하지 않도록 칸 폭의 20%를 더 넘어야 옮김).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lowering jitter suppression steadies the position but follows more slowly. Zones splits the screen into N columns and shows notifications in the middle of a column (it moves only after going 20% of a column width past the border, so it doesn't flicker near borders)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "揺れの抑制を下げると位置は安定しますが、追従が遅くなります。区画分けをオンにすると画面をN列に分け、通知を列の中央に表示します（境界付近で行き来しないよう、列幅の20%を超えてから移動）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降低抖动抑制可使位置更稳定，但跟随变慢。开启区域划分后，屏幕分为 N 列，通知显示在列中央（为避免在边界附近来回跳动，需超过边界列宽的 20% 才会移动）。"
          }
        }
      }
    },
    "랜드마크": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Landmarks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランドマーク"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特征点"
          }
        }
      }
    },
    "랜드마크 없이 얼굴 상자와 머리 방향만 씁니다. 고개를 돌려 보는 경우에 맞고, 눈만 움직이면 따라가지 못합니다. 매 프레임 얼굴 검출이 필요해 검출 간격 설정은 쓰지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses only the face box and head direction, without landmarks. Suits looking by turning your head; it can't follow eye-only movement. Needs face detection every frame, so the detection interval setting isn't used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランドマークを使わず、顔の枠と頭の向きだけを使います。顔を向けて見る場合に向いており、目だけを動かすと追従できません。毎フレーム顔検出が必要なため、検出間隔の設定は使いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用特征点，只使用人脸框和头部朝向。适合转头看的情况，仅移动眼睛时无法跟随。每帧都需要人脸检测，因此不使用检测间隔设置。"
          }
        }
      }
    },

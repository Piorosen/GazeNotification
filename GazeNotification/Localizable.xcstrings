          }
        }
      }
    },
    "특징 이름 위에 포인터를 올리면 설명이 표시됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover over a feature name to see its description."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特徴の名前にポインタを合わせると説明が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针悬停在特征名称上可查看说明。"
          }
        }
      }
    },
    "평균 오차 %@": {
      "localizations": {
        "en": {

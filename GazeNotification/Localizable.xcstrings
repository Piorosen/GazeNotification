            "value": "网站"
          }
        }
      }
    },
    "화면 가로 위치 계산": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate horizontal position"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の横位置を計算"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算屏幕水平位置"
          }
        }
      }
    },
    "화면 구역": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen zones"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の区画"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕区域"
          }
        }
      }
    },
    "화면 꺼짐 또는 장시간 자리 비움": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display off or away for a long time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面オフまたは長時間の離席"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器关闭或长时间离开"
          }
        }
      }
    },
    "화면 상단에 알림 위치 표시": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show notification position at top of screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上部に通知の位置を表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕顶部显示通知位置"
          }
        }
      }
    },
    "화면 양 끝에서 휘어지는 관계까지 반영합니다. 보정 점이 적으면 정확도가 떨어질 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also models the curve near the edges of the screen. May be less accurate with few calibration points."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の両端で曲がる関係まで反映します。キャリブレーション点が少ないと精度が下がることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还会反映屏幕两端的弯曲关系。校准点较少时精度可能下降。"
          }
        }
      }
    },
    "화면 위쪽에 점 %lld개가 왼쪽부터 차례로 표시됩니다.\n평소 화면을 볼 때처럼 각 점을 바라보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dots appear one at a time along the top of the screen, starting from the left.\nLook at each dot as you normally look at the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上部に%lld個の点が左から順に表示されます。\n普段画面を見るときと同じように、各点を見てください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕顶部会从左到右依次显示 %lld 个点。\n请像平时看屏幕一样注视每个点。"
          }
        }
      }
    },
    "화면 위치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen position"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上の位置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕位置"
          }
        }
      }
    },
    "화면 폭의 %@%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%% of screen width"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面幅の%@%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕宽度的 %@%%"
          }
        }
      }
    },
    "화면의 여러 곳을 바라보며 막대가 시선을 따라오는지 확인하세요. 이 탭이 열려 있는 동안 초당 %lld회 추적합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look around the screen and check that the bar follows your gaze. Tracking runs %lld times per second while this tab is open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のいろいろな場所を見て、バーが視線についてくるか確認してください。このタブを開いている間は毎秒%lld回追跡します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请注视屏幕的不同位置，确认位置条是否跟随视线。此标签页打开期间每秒跟踪 %lld 次。"
          }
        }
      }
    },
    "화면이 꺼져 있거나 잠겨 있어 카메라를 일시 정지했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera was paused because the display is off or locked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面がオフまたはロックされているため、カメラを一時停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器已关闭或锁定，摄像头已暂停。"
          }
        }
      }
    },
    "활동 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动"
          }
        }
      }
    },
    "활동 중 Vision 처리: 초당 %@회 (얼굴 검출 %@회, 랜드마크 %@회)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vision runs while Active: %1$@/s (face detection %2$@, landmarks %3$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブ時のVision処理：毎秒%1$@回（顔検出 %2$@回、ランドマーク %3$@回）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "활동 중 Vision 처리: 초당 %1$@회 (얼굴 검출 %2$@회, 랜드마크 %3$@회)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动状态下的 Vision 处理：每秒 %1$@ 次（人脸检测 %2$@ 次，特征点 %3$@ 次）"
          }
        }
      }
    },
    "회/초": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "/s"
          }
        },
        "ja": {
          "stringUnit": {

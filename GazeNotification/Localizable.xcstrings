    },
    "전원 연결 → 균형, 배터리·저전력 모드·발열 → 절전": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power adapter → Balanced; battery, Low Power Mode, or heat → Power Saving"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源接続 → バランス、バッテリー・低電力モード・発熱 → 省電力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接通电源 → 均衡；电池·低电量模式·发热 → 节能"
          }
        }
      }
    },
    "전원 연결됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to power"
          }
        },

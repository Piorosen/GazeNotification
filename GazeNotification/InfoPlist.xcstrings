    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GazeNotification uses the camera to track the direction of your face and eyes, and moves notifications to the part of the screen you are looking at. Video never leaves this Mac and is never saved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GazeNotificationはカメラで顔と目の向きを追跡し、通知を今見ている画面の位置へ移動します。映像がこのMacの外へ送信されたり、保存されたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "GazeNotification은 카메라로 얼굴과 눈의 방향을 추적해, 알림을 지금 보고 있는 화면 위치로 옮깁니다. 영상은 기기 밖으로 전송되거나 저장되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GazeNotification 使用摄像头追踪你的面部和眼睛朝向，并把通知移到你正在看的屏幕位置。视频不会离开这台 Mac，也不会被保存。"
          }
        }
      }
    },
